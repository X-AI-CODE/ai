<!--pages/repo/repo.wxml - 仓库详情页-->
<view class="container">
  <!-- 仓库头部 -->
  <view class="repo-header card">
    <view class="repo-header-top">
      <view class="repo-title-row">
        <text class="repo-title">{{repo.name}}</text>
        <view class="branch-badge" bindtap="showBranchList">
          <text>🌿 {{currentBranch}}</text>
          <text class="arrow">▼</text>
        </view>
      </view>

      <!-- 操作按钮组 -->
      <view class="repo-actions-row">
        <view class="action-group">
          <button class="btn btn-sm btn-outline" bindtap="pullFromRemote">📥 拉取</button>
          <button class="btn btn-sm btn-outline" bindtap="pushToRemote">📤 推送</button>
        </view>
        <view class="action-group">
          <button class="btn btn-sm btn-outline" bindtap="createNewFile">📄 新文件</button>
          <button class="btn btn-sm btn-outline" bindtap="createNewFolder">📁 新文件夹</button>
        </view>
        <view class="action-group">
          <button class="btn btn-sm btn-outline" bindtap="showStash">📌 暂存</button>
          <button class="btn btn-sm btn-outline" bindtap="goToRemotes">🔗 远程</button>
        </view>
      </view>
    </view>
  </view>

  <!-- 标签导航 -->
  <view class="tab-bar">
    <view
      class="tab-item {{currentTab === 'files' ? 'active' : ''}}"
      data-tab="files"
      bindtap="switchTab"
    >
      <text>📁 文件</text>
    </view>
    <view
      class="tab-item {{currentTab === 'status' ? 'active' : ''}}"
      data-tab="status"
      bindtap="switchTab"
    >
      <text>📊 状态</text>
      <view class="tab-badge" wx:if="{{status && (status.modified.length + status.staged.length + status.untracked.length > 0)}}">
        {{status.modified.length + status.staged.length + status.untracked.length}}
      </view>
    </view>
    <view
      class="tab-item {{currentTab === 'history' ? 'active' : ''}}"
      data-tab="history"
      bindtap="switchTab"
    >
      <text>📜 历史</text>
    </view>
  </view>

  <!-- 文件列表 -->
  <view class="tab-content" wx:if="{{currentTab === 'files'}}">
    <!-- 路径面包屑 -->
    <view class="breadcrumb">
      <text class="breadcrumb-item" bindtap="goUp" wx:if="{{currentPath}}">← 上级</text>
      <text class="breadcrumb-path" wx:if="{{currentPath}}">/{{currentPath}}</text>
      <text class="breadcrumb-path" wx:else>/</text>
    </view>

    <!-- 文件列表 -->
    <view class="file-list card">
      <view
        class="file-item"
        wx:for="{{files}}"
        wx:key="path"
      >
        <view class="file-icon" bindtap="{{item.isDirectory ? 'enterDir' : 'openFile'}}" data-path="{{item.name}}">
          <text wx:if="{{item.isDirectory}}">📁</text>
          <text wx:elif="{{item.name.endsWith('.js') || item.name.endsWith('.ts')}}">📜</text>
          <text wx:elif="{{item.name.endsWith('.json')}}">📋</text>
          <text wx:elif="{{item.name.endsWith('.md')}}">📝</text>
          <text wx:elif="{{item.name.endsWith('.png') || item.name.endsWith('.jpg') || item.name.endsWith('.svg')}}">🖼️</text>
          <text wx:else>📄</text>
        </view>
        <view class="file-info" bindtap="{{item.isDirectory ? 'enterDir' : 'openFile'}}" data-path="{{item.name}}">
          <text class="file-name">{{item.name}}</text>
          <text class="file-size" wx:if="{{!item.isDirectory}}">{{item.size}} bytes</text>
        </view>
      </view>

      <view class="empty-hint" wx:if="{{files.length === 0}}">
        <text>此目录为空</text>
      </view>
    </view>
  </view>

  <!-- 状态页 -->
  <view class="tab-content" wx:if="{{currentTab === 'status'}}">
    <view class="status-section card">
      <view class="section-header flex-between">
        <text class="section-title">已暂存</text>
        <button class="btn btn-sm btn-primary" bindtap="doCommit" wx:if="{{status && status.staged.length > 0}}">
          提交 ({{status.staged.length}})
        </button>
      </view>

      <view class="file-change-item" wx:if="{{status}}">
        <view
          class="change-item"
          wx:for="{{status.staged}}"
          wx:key="path"
        >
          <text class="change-type type-added" wx:if="{{item.status === 'added'}}">A</text>
          <text class="change-type type-modified" wx:elif="{{item.status === 'modified'}}">M</text>
          <text class="change-type type-deleted" wx:elif="{{item.status === 'deleted'}}">D</text>
          <text class="change-path">{{item.path}}</text>
          <text class="unstage-btn" catchtap="unstageFile" data-path="{{item.path}}">✕</text>
        </view>
        <view class="empty-hint" wx:if="{{status.staged.length === 0}}">
          <text>暂无暂存文件</text>
        </view>
      </view>
    </view>

    <view class="status-section card">
      <view class="section-header flex-between">
        <text class="section-title">未暂存的更改</text>
        <view class="flex">
          <button class="btn btn-sm btn-outline mr-10" bindtap="stageSelected">暂存选中</button>
          <button class="btn btn-sm btn-success" bindtap="stageAll">全部暂存</button>
        </view>
      </view>

      <view wx:if="{{status}}">
        <view
          class="change-item"
          wx:for="{{status.modified}}"
          wx:key="path"
          bindtap="toggleFileSelect"
          data-path="{{item.path}}"
        >
          <view class="checkbox {{selectedFiles.indexOf(item.path) >= 0 ? 'checked' : ''}}"></view>
          <text class="change-type type-modified">M</text>
          <text class="change-path">{{item.path}}</text>
        </view>

        <view
          class="change-item"
          wx:for="{{status.untracked}}"
          wx:key="path"
          bindtap="toggleFileSelect"
          data-path="{{item.path}}"
        >
          <view class="checkbox {{selectedFiles.indexOf(item.path) >= 0 ? 'checked' : ''}}"></view>
          <text class="change-type type-untracked">?</text>
          <text class="change-path">{{item.path}}</text>
        </view>

        <view
          class="change-item"
          wx:for="{{status.deleted}}"
          wx:key="path"
          bindtap="toggleFileSelect"
          data-path="{{item.path}}"
        >
          <view class="checkbox {{selectedFiles.indexOf(item.path) >= 0 ? 'checked' : ''}}"></view>
          <text class="change-type type-deleted">D</text>
          <text class="change-path">{{item.path}}</text>
        </view>

        <view class="empty-hint" wx:if="{{status.modified.length === 0 && status.untracked.length === 0 && status.deleted.length === 0}}">
          <text>工作区干净</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 历史页 -->
  <view class="tab-content" wx:if="{{currentTab === 'history'}}">
    <view class="commit-list">
      <view
        class="commit-item card"
        wx:for="{{commitLog}}"
        wx:key="hash"
        bindtap="viewCommit"
        data-hash="{{item.hash}}"
      >
        <view class="commit-info">
          <text class="commit-message">{{item.message}}</text>
          <view class="commit-meta">
            <text class="commit-hash">{{item.shortHash}}</text>
            <text class="commit-author">{{item.author.name}}</text>
            <text class="commit-time">{{item.author.timestamp}}</text>
          </view>
        </view>
      </view>

      <view class="empty-hint" wx:if="{{commitLog.length === 0}}">
        <text>暂无提交历史</text>
      </view>
    </view>
  </view>

  <!-- 分支选择弹窗 -->
  <view class="modal-mask" wx:if="{{showBranchPicker}}" bindtap="hideBranchList">
    <view class="modal-content modal-bottom" catchtap="">
      <view class="modal-header">
        <text class="modal-title">切换分支</text>
        <text class="modal-close" bindtap="hideBranchList">✕</text>
      </view>
      <view class="branch-list">
        <view
          class="branch-item {{item.isCurrent ? 'current' : ''}}"
          wx:for="{{branches}}"
          wx:key="name"
          bindtap="switchBranch"
          data-branch="{{item.name}}"
        >
          <text class="branch-icon">{{item.isCurrent ? '✅' : '🌿'}}</text>
          <text class="branch-name">{{item.name}}</text>
          <text class="branch-hash">{{item.hash}}</text>
        </view>
      </view>
      <view class="modal-footer">
        <button class="btn btn-primary btn-block" bindtap="createBranch">+ 新建分支</button>
      </view>
    </view>
  </view>

  <!-- 提交弹窗 -->
  <view class="modal-mask" wx:if="{{showCommitModal}}" bindtap="hideCommit">
    <view class="modal-content" catchtap="">
      <view class="modal-header">
        <text class="modal-title">提交更改</text>
        <text class="modal-close" bindtap="hideCommit">✕</text>
      </view>
      <view class="modal-body">
        <view class="input-group">
          <text class="input-label">提交信息</text>
          <textarea
            class="commit-textarea"
            placeholder="描述你的更改..."
            value="{{commitMessage}}"
            bindinput="onCommitMessageInput"
            auto-focus
          />
        </view>
        <view class="staged-summary" wx:if="{{status}}">
          <text class="text-muted text-small">将提交 {{status.staged.length}} 个文件</text>
        </view>
      </view>
      <view class="modal-footer">
        <button class="btn btn-outline" bindtap="hideCommit">取消</button>
        <button class="btn btn-primary" bindtap="doCommit">提交</button>
      </view>
    </view>
  </view>

  <!-- 暂存弹窗 -->
  <view class="modal-mask" wx:if="{{showStashModal}}" bindtap="hideStash">
    <view class="modal-content" catchtap="">
      <view class="modal-header">
        <text class="modal-title">暂存 (Stash)</text>
        <text class="modal-close" bindtap="hideStash">✕</text>
      </view>
      <view class="modal-body">
        <view class="input-group">
          <text class="input-label">暂存描述</text>
          <input
            class="input"
            placeholder="可选的暂存描述..."
            value="{{stashMessage}}"
            bindinput="onStashMessageInput"
          />
        </view>

        <!-- 已有暂存列表 -->
        <view class="stash-list" wx:if="{{stashList.length > 0}}">
          <text class="input-label">已有暂存</text>
          <view
            class="stash-item"
            wx:for="{{stashList}}"
            wx:key="id"
          >
            <view class="stash-info">
              <text class="stash-msg">{{item.message}}</text>
              <text class="stash-time text-small text-muted">{{item.timestamp}}</text>
            </view>
            <button class="btn btn-sm btn-outline" catchtap="popStash" data-index="{{index}}">恢复</button>
          </view>
        </view>
      </view>
      <view class="modal-footer">
        <button class="btn btn-outline" bindtap="hideStash">取消</button>
        <button class="btn btn-primary" bindtap="doStash">保存暂存</button>
      </view>
    </view>
  </view>
</view>
